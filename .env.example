# Set these in the process environment; Python does not auto-load this file.
# PowerShell example: $env:GCP_PROJECT_ID = "your-gcp-project-id"
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=secom_quality
BQ_LOCATION=your-bigquery-region
BQ_RAW_TABLE=secom_raw
BQ_PREDICTIONS_TABLE=quality_predictions
DATA_BACKEND=bigquery

# Use Application Default Credentials, e.g. gcloud auth application-default login.
